            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "type": "radio",
          "layout": {
            "row": "Row_081y8ho",
            "columns": null
          },
          "id": "Field_1jsrao0",
          "key": "containsAllergens",
          "validate": {
            "required": true
          }
        },
        {
          "label": "Allergens present",
          "values": [
            {
              "label": "Celery",
              "value": "celery"
            },
            {
              "label": "Cereals containing gluten",
              "value": "gluten"
            },
            {
              "label": "Crustaceans",
              "value": "crustaceans"
            },
            {
              "label": "Eggs",
              "value": "eggs"
            },
            {
              "label": "Fish",
              "value": "fish"
            },
            {
              "label": "Lupin",
              "value": "lupin"
            },
            {
              "label": "Milk",
              "value": "milk"
            },
            {
              "label": "Molluscs",
              "value": "molluscs"
            },
            {
              "label": "Mustard",
              "value": "mustard"
            },
            {
              "label": "Peanuts",
              "value": "peanuts"
            },
            {
              "label": "Tree Nuts",
              "value": "nuts"
            },
            {
              "label": "Sesame",
              "value": "sesame"
            },
            {
              "label": "Soya",
              "value": "soya"
            },
            {
              "label": "Sulphur dioxide / sulphites",
              "value": "sulphites"
            }
          ],
          "type": "checklist",
          "layout": {
            "row": "Row_081y8ho",
            "columns": null
          },
          "id": "Field_02dok3h",
          "key": "allergens",
          "validate": {
            "required": true
          },
          "conditional": {
            "hide": "=containsAllergens != \"yes\""
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "layout": {
        "row": "Row_1mh0ynu",
