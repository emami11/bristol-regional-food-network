          "layout": {
            "row": "Row_1jqrigz",
            "columns": null
          },
          "id": "Field_0iavws2",
          "key": "harvestDate",
          "validate": {
            "required": true
          }
        },
        {
          "subtype": "date",
          "dateLabel": "Best-before date",
