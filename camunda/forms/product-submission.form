          }
        },
        {
          "subtype": "date",
          "dateLabel": "Certificate expiry date",
          "type": "datetime",
          "layout": {
            "row": "Row_18imcnr",
            "columns": null
          },
          "id": "Field_060crja",
          "key": "certExpiry",
          "validate": {
            "required": true
          },
          "conditional": {
            "hide": "=organicClaimed != true"
