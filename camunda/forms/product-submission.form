{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "64767e4"
  },
  "schemaVersion": 19,
  "id": "product-submission",
  "components": [
    {
      "label": "Product",
      "components": [
        {
          "label": "Product Name",
          "type": "textfield",
          "layout": {
            "row": "Row_03971t8",
            "columns": null
          },
          "id": "Field_16n6is1",
          "key": "productName",
          "validate": {
            "required": true,
            "maxLength": "80"
          }
        },
        {
          "label": "Description",
          "type": "textarea",
          "layout": {
            "row": "Row_03971t8",
            "columns": null
          },
          "id": "Field_01hguuu",
          "key": "description",
          "validate": {
            "required": true
          }
        },
        {
          "label": "Category",
          "values": [
            {
              "label": "Vegetables",
              "value": "vegetables"
            },
            {
              "label": "Fruit",
              "value": "fruit"
            },
            {
              "label": "Dairy Products",
              "value": "dairy"
            },
            {
              "label": "Bakery goods",
              "value": "bakery"
            },
            {
              "label": "Preserves",
              "value": "preserves"
            },
            {
              "label": "Meat and Fish",
              "value": "meat"
            },
            {
              "label": "Seasonal Specialities",
              "value": "seasonal"
            }
          ],
          "type": "select",
          "layout": {
            "row": "Row_03971t8",
            "columns": null
          },
          "id": "Field_17qkqbf",
          "key": "category",
          "defaultValue": "vegetables",
          "validate": {
            "required": true
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "layout": {
        "row": "Row_1nvya0s",
        "columns": 16
      },
      "id": "Field_0k3gjh2"
    },
    {
      "label": "Price and Stock",
      "components": [
        {
          "label": "Price (£)",
          "type": "number",
          "layout": {
            "row": "Row_0y07alp",
            "columns": null
          },
          "id": "Field_167xwyz",
          "key": "price",
          "validate": {
            "required": true,
            "min": "0.01"
          },
          "decimalDigits": 2,
          "appearance": {
            "prefixAdorner": "£"
          }
        },
        {
          "label": "Sold per",
          "values": [
            {
              "label": "Kilogram",
              "value": "kg"
            },
            {
              "label": "Each",
              "value": "each"
            },
            {
              "label": "500 g pack",
              "value": "500g"
            },
            {
              "label": "Bunch",
              "value": "bunch"
            },
            {
              "label": "Jar",
              "value": "jar"
            },
            {
              "label": "Loaf",
              "value": "loaf"
            },
            {
              "label": "Dozen",
              "value": "dozen"
            },
            {
              "label": "Litre",
              "value": "litre"
            }
          ],
          "type": "select",
          "layout": {
            "row": "Row_0y07alp",
            "columns": null
          },
          "id": "Field_0c6d8q9",
          "key": "unit",
          "validate": {
            "required": true
          }
        },
        {
          "label": "Available quantity",
          "type": "number",
          "layout": {
            "row": "Row_0y07alp",
            "columns": null
          },
          "id": "Field_0ij7l4s",
          "key": "quantity",
          "validate": {
            "required": true,
            "min": "0"
          },
          "decimalDigits": 0
        }
      ],
      "showOutline": true,
      "type": "group",
      "layout": {
        "row": "Row_1vqxpcc",
        "columns": null
      },
      "id": "Field_0gnsg9s"
