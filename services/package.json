{
  "name": "brfn-services",
  "version": "0.1.0",
  "private": true,
  "description": "Job workers and a simulated organic certification service for BRFN Use Case 1 (F1 and F2).",
  "main": "src/index.js",
  "scripts": {
    "mock": "node src/cert-mock/server.js",
    "workers": "node src/index.js",
    "test": "node --test test/*.test.js",
    "build:simulation": "node scripts/build-simulation.mjs",
    "demo": "npm run build:simulation && node src/demo/run.js",
    "test:engine": "node integration/engine.scenarios.cjs",
    "test:tokens": "node scripts/check-tokens.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@camunda8/sdk": "8.7.8",
    "bpmn-js": "18.31.1",
    "bpmn-js-token-simulation": "1.1.0",
    "dotenv": "16.4.7",
    "esbuild": "0.28.2",
    "express": "4.21.2"
  }
}
