# Copy this file to .env and fill it in. Never commit .env (it holds secrets).

# --- Camunda 8 SaaS ---------------------------------------------------------
# Console -> your cluster -> API -> Create new client (scope: Zeebe).
# Console then shows these values; paste them here.
ZEEBE_GRPC_ADDRESS=
ZEEBE_REST_ADDRESS=
ZEEBE_CLIENT_ID=
ZEEBE_CLIENT_SECRET=
CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token
ZEEBE_TOKEN_AUDIENCE=zeebe.camunda.io

# --- OR Camunda 8 Run on your own laptop -------------------------------------
# Comment out the SaaS block above and use these instead.
# ZEEBE_GRPC_ADDRESS=localhost:26500
# ZEEBE_REST_ADDRESS=http://localhost:8080
# CAMUNDA_AUTH_STRATEGY=NONE
# CAMUNDA_SECURE_CONNECTION=false

# --- Simulated certification service -----------------------------------------
CERT_SERVICE_URL=http://localhost:4010
CERT_MOCK_PORT=4010
# Start the mock already "down" to test the outage path
CERT_MOCK_DOWN=false
# How hard the worker tries before throwing CERT_SERVICE_DOWN
CERT_SERVICE_ATTEMPTS=3
CERT_SERVICE_TIMEOUT_MS=3000
CERT_SERVICE_RETRY_DELAY_MS=1000
