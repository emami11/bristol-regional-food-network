        <bpmn:outgoing>Flow_14995gy</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Activity_16wt9bj" name="Allocate Orders to Producers">
        <bpmn:documentation>This activity coordinates customer orders across the relevant food producers. Once an order is confirmed, the resulting stock changes would need to be reflected in Inventory and Seasonal Availability Management (F2), so the marketplace continues to show accurate product availability. Order cancellations could also require stock quantities to be updated.</bpmn:documentation>
        <bpmn:incoming>Flow_14995gy</bpmn:incoming>
        <bpmn:outgoing>Flow_1r23qrq</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_14995gy" sourceRef="Event_0avm2za" targetRef="Activity_16wt9bj" />
      <bpmn:endEvent id="Event_0tcu6q5" name="Producer Orders Coordinated">
