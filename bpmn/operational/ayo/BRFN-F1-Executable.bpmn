<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="BRFN_F1_Executable_defs" targetNamespace="https://brfn.example/operational" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:process id="BRFN_F1_Executable" name="F1 - Product listing and validation" isExecutable="true">
    <bpmn:startEvent id="F1_Start" name="Start product listing">
      <bpmn:outgoing>F1_Start_to_F1_Init_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="F1_Init" name="Initialise listing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-initialise-listing" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Start_to_F1_Init_0</bpmn:incoming>
      <bpmn:outgoing>F1_Init_to_F1_Submit_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="F1_Submit" name="Submit product details">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="BRFN_Product_Form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Init_to_F1_Submit_1</bpmn:incoming>
      <bpmn:outgoing>F1_Submit_to_F1_Validate_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="F1_Validate" name="Validate product information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-product" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Submit_to_F1_Validate_2</bpmn:incoming>
      <bpmn:incoming>F1_Continue_to_F1_Validate_8</bpmn:incoming>
      <bpmn:outgoing>F1_Validate_to_F1_DataValid_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F1_DataValid" name="Product details valid?" default="F1_DataValid_to_F1_Correct_5">
      <bpmn:incoming>F1_Validate_to_F1_DataValid_3</bpmn:incoming>
      <bpmn:outgoing>F1_DataValid_to_F1_Organic_4</bpmn:outgoing>
      <bpmn:outgoing>F1_DataValid_to_F1_Correct_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="F1_Correct" name="Correct details or certificate">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="BRFN_Correction_Form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_DataValid_to_F1_Correct_5</bpmn:incoming>
      <bpmn:incoming>F1_CertValid_to_F1_Correct_16</bpmn:incoming>
      <bpmn:outgoing>F1_Correct_to_F1_Continue_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="F1_Continue" name="Resubmit?" default="F1_Continue_to_F1_Validate_8">
      <bpmn:incoming>F1_Correct_to_F1_Continue_6</bpmn:incoming>
      <bpmn:outgoing>F1_Continue_to_F1_Reject_7</bpmn:outgoing>
      <bpmn:outgoing>F1_Continue_to_F1_Validate_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F1_Reject" name="Record withdrawn listing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-reject-listing" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Continue_to_F1_Reject_7</bpmn:incoming>
      <bpmn:outgoing>F1_Reject_to_F1_Rejected_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F1_Rejected" name="Listing withdrawn">
      <bpmn:incoming>F1_Reject_to_F1_Rejected_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="F1_Abandoned" name="Correction deadline" attachedToRef="F1_Correct" cancelActivity="true">
      <bpmn:outgoing>F1_Abandoned_to_F1_Archive_10</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>=correctionTimeout</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="F1_Archive" name="Archive abandoned listing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-archive-listing" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Abandoned_to_F1_Archive_10</bpmn:incoming>
      <bpmn:outgoing>F1_Archive_to_F1_Archived_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F1_Archived" name="Listing archived">
      <bpmn:incoming>F1_Archive_to_F1_Archived_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="F1_Organic" name="Organic claim?" default="F1_Organic_to_F1_Availability_13">
      <bpmn:incoming>F1_DataValid_to_F1_Organic_4</bpmn:incoming>
      <bpmn:outgoing>F1_Organic_to_F1_Verify_12</bpmn:outgoing>
      <bpmn:outgoing>F1_Organic_to_F1_Availability_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F1_Verify" name="Verify certification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-certificate" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Organic_to_F1_Verify_12</bpmn:incoming>
      <bpmn:outgoing>F1_Verify_to_F1_CertValid_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="F1_CertDown" name="Service unavailable" attachedToRef="F1_Verify" cancelActivity="true">
      <bpmn:outgoing>F1_CertDown_to_F1_Admin_17</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="F1_CertDownError" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="F1_Admin" name="Review certification evidence">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="BRFN_Admin_Form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_CertDown_to_F1_Admin_17</bpmn:incoming>
      <bpmn:incoming>F1_AdminValid_to_F1_Admin_21</bpmn:incoming>
      <bpmn:outgoing>F1_Admin_to_F1_RecordAdmin_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="F1_RecordAdmin" name="Record admin decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-record-admin" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Admin_to_F1_RecordAdmin_18</bpmn:incoming>
      <bpmn:outgoing>F1_RecordAdmin_to_F1_AdminValid_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F1_AdminValid" name="Review complete?" default="F1_AdminValid_to_F1_Admin_21">
      <bpmn:incoming>F1_RecordAdmin_to_F1_AdminValid_19</bpmn:incoming>
      <bpmn:outgoing>F1_AdminValid_to_F1_CertValid_20</bpmn:outgoing>
      <bpmn:outgoing>F1_AdminValid_to_F1_Admin_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="F1_CertValid" name="Certificate accepted?" default="F1_CertValid_to_F1_Correct_16">
      <bpmn:incoming>F1_Verify_to_F1_CertValid_14</bpmn:incoming>
      <bpmn:incoming>F1_AdminValid_to_F1_CertValid_20</bpmn:incoming>
      <bpmn:outgoing>F1_CertValid_to_F1_Availability_15</bpmn:outgoing>
      <bpmn:outgoing>F1_CertValid_to_F1_Correct_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="F1_Availability" name="Determine product availability">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="product-availability" resultVariable="availabilityStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Organic_to_F1_Availability_13</bpmn:incoming>
      <bpmn:incoming>F1_CertValid_to_F1_Availability_15</bpmn:incoming>
      <bpmn:outgoing>F1_Availability_to_F1_Publish_22</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="F1_Publish" name="Publish listing and start inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-publish-listing" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Availability_to_F1_Publish_22</bpmn:incoming>
      <bpmn:outgoing>F1_Publish_to_F1_Notify_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F1_Notify" name="Notify producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-producer" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_Publish_to_F1_Notify_23</bpmn:incoming>
      <bpmn:outgoing>F1_Notify_to_F1_End_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F1_End" name="Listing published">
      <bpmn:incoming>F1_Notify_to_F1_End_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1_Start_to_F1_Init_0" sourceRef="F1_Start" targetRef="F1_Init" />
    <bpmn:sequenceFlow id="F1_Init_to_F1_Submit_1" sourceRef="F1_Init" targetRef="F1_Submit" />
    <bpmn:sequenceFlow id="F1_Submit_to_F1_Validate_2" sourceRef="F1_Submit" targetRef="F1_Validate" />
    <bpmn:sequenceFlow id="F1_Validate_to_F1_DataValid_3" sourceRef="F1_Validate" targetRef="F1_DataValid" />
    <bpmn:sequenceFlow id="F1_DataValid_to_F1_Organic_4" sourceRef="F1_DataValid" targetRef="F1_Organic" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= dataValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1_DataValid_to_F1_Correct_5" sourceRef="F1_DataValid" targetRef="F1_Correct" name="No" />
    <bpmn:sequenceFlow id="F1_Correct_to_F1_Continue_6" sourceRef="F1_Correct" targetRef="F1_Continue" />
    <bpmn:sequenceFlow id="F1_Continue_to_F1_Reject_7" sourceRef="F1_Continue" targetRef="F1_Reject" name="Withdraw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= correctionAction = "WITHDRAW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1_Continue_to_F1_Validate_8" sourceRef="F1_Continue" targetRef="F1_Validate" name="Resubmit" />
    <bpmn:sequenceFlow id="F1_Reject_to_F1_Rejected_9" sourceRef="F1_Reject" targetRef="F1_Rejected" />
    <bpmn:sequenceFlow id="F1_Abandoned_to_F1_Archive_10" sourceRef="F1_Abandoned" targetRef="F1_Archive" />
    <bpmn:sequenceFlow id="F1_Archive_to_F1_Archived_11" sourceRef="F1_Archive" targetRef="F1_Archived" />
    <bpmn:sequenceFlow id="F1_Organic_to_F1_Verify_12" sourceRef="F1_Organic" targetRef="F1_Verify" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= organicClaimed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1_Organic_to_F1_Availability_13" sourceRef="F1_Organic" targetRef="F1_Availability" name="No" />
    <bpmn:sequenceFlow id="F1_Verify_to_F1_CertValid_14" sourceRef="F1_Verify" targetRef="F1_CertValid" />
    <bpmn:sequenceFlow id="F1_CertValid_to_F1_Availability_15" sourceRef="F1_CertValid" targetRef="F1_Availability" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= certValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1_CertValid_to_F1_Correct_16" sourceRef="F1_CertValid" targetRef="F1_Correct" name="No" />
    <bpmn:sequenceFlow id="F1_CertDown_to_F1_Admin_17" sourceRef="F1_CertDown" targetRef="F1_Admin" />
    <bpmn:sequenceFlow id="F1_Admin_to_F1_RecordAdmin_18" sourceRef="F1_Admin" targetRef="F1_RecordAdmin" />
    <bpmn:sequenceFlow id="F1_RecordAdmin_to_F1_AdminValid_19" sourceRef="F1_RecordAdmin" targetRef="F1_AdminValid" />
    <bpmn:sequenceFlow id="F1_AdminValid_to_F1_CertValid_20" sourceRef="F1_AdminValid" targetRef="F1_CertValid" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= adminReviewValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1_AdminValid_to_F1_Admin_21" sourceRef="F1_AdminValid" targetRef="F1_Admin" name="No" />
    <bpmn:sequenceFlow id="F1_Availability_to_F1_Publish_22" sourceRef="F1_Availability" targetRef="F1_Publish" />
    <bpmn:sequenceFlow id="F1_Publish_to_F1_Notify_23" sourceRef="F1_Publish" targetRef="F1_Notify" />
    <bpmn:sequenceFlow id="F1_Notify_to_F1_End_24" sourceRef="F1_Notify" targetRef="F1_End" />
  </bpmn:process>
  <bpmn:error id="F1_CertDownError" name="Certification service unavailable" errorCode="CERT_SERVICE_DOWN" />
  <bpmndi:BPMNDiagram id="BRFN_F1_Executable_diagram">
    <bpmndi:BPMNPlane id="BRFN_F1_Executable_plane" bpmnElement="BRFN_F1_Executable">
      <bpmndi:BPMNShape id="F1_Start_shape" bpmnElement="F1_Start">
        <dc:Bounds x="50" y="380" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="8" y="424" width="120" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Init_shape" bpmnElement="F1_Init">
        <dc:Bounds x="150" y="355" width="145" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Submit_shape" bpmnElement="F1_Submit">
        <dc:Bounds x="340" y="130" width="145" height="82" />
