      <bpmndi:BPMNShape id="F1_Validate_shape" bpmnElement="F1_Validate">
        <dc:Bounds x="530" y="355" width="145" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_DataValid_shape" bpmnElement="F1_DataValid" isMarkerVisible="true">
