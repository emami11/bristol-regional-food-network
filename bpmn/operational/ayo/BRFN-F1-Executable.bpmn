          <dc:Bounds x="703" y="428" width="134" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Correct_shape" bpmnElement="F1_Correct">
        <dc:Bounds x="720" y="130" width="145" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Continue_shape" bpmnElement="F1_Continue" isMarkerVisible="true">
        <dc:Bounds x="925" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="883" y="203" width="134" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Reject_shape" bpmnElement="F1_Reject">
        <dc:Bounds x="1080" y="120" width="145" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_Rejected_shape" bpmnElement="F1_Rejected">
        <dc:Bounds x="1290" y="145" width="36" height="36" />
