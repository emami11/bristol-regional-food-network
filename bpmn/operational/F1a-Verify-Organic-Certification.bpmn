    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Cerificate check requested">
      <bpmn:outgoing>Flow_0jyzpcd</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_1msfq8m" name="verification complete">
      <bpmn:incoming>Flow_12mq51g</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_0z1uj0f" name="Record verification outcome">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-verification-audit" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cmthjr</bpmn:incoming>
      <bpmn:outgoing>Flow_12mq51g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1c1822y">
      <bpmn:incoming>Flow_1jvn7il</bpmn:incoming>
      <bpmn:incoming>Flow_04211rw</bpmn:incoming>
      <bpmn:outgoing>Flow_0cmthjr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_01mdby5" name="Request certificate verification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-certificate" />
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;AUTOMATIC&#34;" target="verificationMethod" />
          <zeebe:output source="=certVerified" target="certVerified" />
          <zeebe:output source="=certReason" target="certReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0jyzpcd</bpmn:incoming>
      <bpmn:outgoing>Flow_1jvn7il</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_09xhkux" name="Review certificate manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="manual-cert-review" />
        <zeebe:ioMapping>
          <zeebe:output source="=certDecision = &#34;APPROVED&#34;" target="certVerified" />
          <zeebe:output source="=certNotes" target="certReason" />
          <zeebe:output source="=&#34;MANUAL&#34;" target="verificationMethod" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05unygm</bpmn:incoming>
      <bpmn:outgoing>Flow_04211rw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_0x1atzi" name="Service Unavailable" attachedToRef="Activity_01mdby5">
      <bpmn:outgoing>Flow_05unygm</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0xvu829" errorRef="Error_15rtxhj" />
