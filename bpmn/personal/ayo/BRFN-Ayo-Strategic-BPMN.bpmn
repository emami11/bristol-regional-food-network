<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Ayo_Definitions" targetNamespace="https://brfn.example/ayo/strategic" exporter="BRFN personal strategic model" exporterVersion="2026-11-03" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Ayo_Collaboration" name="BRFN whole-enterprise strategic collaboration">
    <bpmn:participant id="Ayo_Pool_BRfn" name="Bristol Regional Food Network (BRFN)" processRef="Ayo_BRfnProcess" />
    <bpmn:participant id="Ayo_Pool_Producer" name="Registered Producers" />
    <bpmn:participant id="Ayo_Pool_Customers" name="Customers (individuals, restaurants/cafes and community organisations)" />
    <bpmn:participant id="Ayo_Pool_Certification" name="Certification Verification Service" />
    <bpmn:participant id="Ayo_Pool_Payment" name="Payment Service Provider (sandbox)" />
    <bpmn:messageFlow id="Ayo_MF_ListingIn" name="Product listing submission" sourceRef="Ayo_Pool_Producer" targetRef="Ayo_Start_Listing" />
    <bpmn:messageFlow id="Ayo_MF_ListingOut" name="Listing decision / correction feedback" sourceRef="Ayo_SP_Listings" targetRef="Ayo_Pool_Producer" />
    <bpmn:messageFlow id="Ayo_MF_CertRequest" name="Organic certification request" sourceRef="Ayo_SP_Listings" targetRef="Ayo_Pool_Certification" />
    <bpmn:messageFlow id="Ayo_MF_CertResult" name="Certification result / error" sourceRef="Ayo_Pool_Certification" targetRef="Ayo_SP_Listings" />
    <bpmn:messageFlow id="Ayo_MF_StockUpdate" name="Quantity and seasonal updates" sourceRef="Ayo_Pool_Producer" targetRef="Ayo_Start_Inventory" />
    <bpmn:messageFlow id="Ayo_MF_PurchaseIn" name="Customer purchase request" sourceRef="Ayo_Pool_Customers" targetRef="Ayo_Start_Purchase" />
    <bpmn:messageFlow id="Ayo_MF_PurchaseOut" name="Order/payment outcome and arrangements" sourceRef="Ayo_SP_Payments" targetRef="Ayo_Pool_Customers" />
    <bpmn:messageFlow id="Ayo_MF_PaymentRequest" name="Sandbox payment / transfer request" sourceRef="Ayo_SP_Payments" targetRef="Ayo_Pool_Payment" />
    <bpmn:messageFlow id="Ayo_MF_PaymentResult" name="Payment / transfer outcome" sourceRef="Ayo_Pool_Payment" targetRef="Ayo_SP_Payments" />
    <bpmn:messageFlow id="Ayo_MF_ProducerOrders" name="Confirmed orders / weekly settlement statement" sourceRef="Ayo_SP_Payments" targetRef="Ayo_Pool_Producer" />
    <bpmn:messageFlow id="Ayo_MF_ProducerConcern" name="Producer quality concern" sourceRef="Ayo_Pool_Producer" targetRef="Ayo_Start_Quality" />
    <bpmn:messageFlow id="Ayo_MF_CustomerConcern" name="Customer quality concern" sourceRef="Ayo_Pool_Customers" targetRef="Ayo_Start_Quality" />
    <bpmn:messageFlow id="Ayo_MF_EvidenceRequest" name="Investigation evidence request" sourceRef="Ayo_SP_Quality" targetRef="Ayo_Pool_Producer" />
    <bpmn:messageFlow id="Ayo_MF_EvidenceReply" name="Producer evidence / response" sourceRef="Ayo_Pool_Producer" targetRef="Ayo_SP_Quality" />
    <bpmn:messageFlow id="Ayo_MF_SafetyNotice" name="Confirmed risk notification / guidance" sourceRef="Ayo_SP_Quality" targetRef="Ayo_Pool_Customers" />
    <bpmn:messageFlow id="Ayo_MF_CommunityIn" name="Surplus offer / recipe / farm content" sourceRef="Ayo_Pool_Producer" targetRef="Ayo_Start_Community" />
    <bpmn:messageFlow id="Ayo_MF_CommunityOut" name="Surplus offers / seasonal and community updates" sourceRef="Ayo_SP_Community" targetRef="Ayo_Pool_Customers" />
  </bpmn:collaboration>
  <bpmn:process id="Ayo_BRfnProcess" name="BRFN strategic BPMN - Ayo" isExecutable="false">
    <bpmn:documentation>Personal strategic modelling draft based on repository 9aeeddc, 3 November 2026. Represents three organisational areas and seven major business processes. Collapsed internals are high-level responsibilities, not final operational automation. Daily stock checks and weekly settlements are business policies described in annotations; the detailed operational processes must implement their independent triggers. All financial interactions are sandbox or simulated.</bpmn:documentation>
    <bpmn:laneSet id="Ayo_LaneSet">
      <bpmn:lane id="Ayo_Lane_Product" name="Product and Inventory Management">
        <bpmn:flowNodeRef>Ayo_Start_Listing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_Start_Inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_SP_Listings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_SP_Inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_End_Listing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_End_Inventory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Ayo_Lane_Operations" name="Marketplace Operations">
        <bpmn:flowNodeRef>Ayo_Start_Purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_SP_Purchasing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_SP_Orders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_SP_Payments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_End_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_End_NotPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_Gateway_Payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Ayo_Lane_Quality" name="Quality Assurance and Community Services">
        <bpmn:flowNodeRef>Ayo_Start_Quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_Start_Community</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_SP_Quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_SP_Community</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_End_Quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ayo_End_Community</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Ayo_Start_Listing" name="Producer listing request received">
      <bpmn:messageEventDefinition id="Ayo_Start_Listing_message" messageRef="Ayo_Msg_Listing" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Ayo_Start_Inventory" name="Producer stock / season update received">
      <bpmn:messageEventDefinition id="Ayo_Start_Inventory_message" messageRef="Ayo_Msg_Stock" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Ayo_Start_Purchase" name="Customer purchase request received">
      <bpmn:messageEventDefinition id="Ayo_Start_Purchase_message" messageRef="Ayo_Msg_Purchase" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Ayo_Start_Quality" name="Food quality concern received">
      <bpmn:messageEventDefinition id="Ayo_Start_Quality_message" messageRef="Ayo_Msg_Quality" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Ayo_Start_Community" name="Community content submitted">
      <bpmn:messageEventDefinition id="Ayo_Start_Community_message" messageRef="Ayo_Msg_Community" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Ayo_SP_Listings" name="Manage Product Listings">
      <bpmn:documentation>Producer submission, mandatory validation, applicable simulated certification checking, correction feedback and publication. Unresolved verification can be held for authorised admin review; never treat an outage as proof of certification.</bpmn:documentation>
      <bpmn:ioSpecification id="Ayo_SP_Listings_io">
        <bpmn:dataOutput id="Ayo_SP_Listings_out_1" name="Catalogue and availability" />
        <bpmn:inputSet id="Ayo_SP_Listings_inputs" />
        <bpmn:outputSet id="Ayo_SP_Listings_outputs">
          <bpmn:dataOutputRefs>Ayo_SP_Listings_out_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Ayo_DataOut_Listing">
        <bpmn:sourceRef>Ayo_SP_Listings_out_1</bpmn:sourceRef>
        <bpmn:targetRef>Ayo_Data_Catalogue</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="Ayo_SP_Listings_start" name="Responsibility begins" />
      <bpmn:task id="Ayo_SP_Listings_step_1" name="Receive and validate product information" />
      <bpmn:sequenceFlow id="Ayo_SP_Listings_inner_1" sourceRef="Ayo_SP_Listings_start" targetRef="Ayo_SP_Listings_step_1" />
      <bpmn:task id="Ayo_SP_Listings_step_2" name="Resolve corrections and certification checks as applicable" />
      <bpmn:sequenceFlow id="Ayo_SP_Listings_inner_2" sourceRef="Ayo_SP_Listings_step_1" targetRef="Ayo_SP_Listings_step_2" />
      <bpmn:task id="Ayo_SP_Listings_step_3" name="Publish approved listing or provide feedback" />
      <bpmn:sequenceFlow id="Ayo_SP_Listings_inner_3" sourceRef="Ayo_SP_Listings_step_2" targetRef="Ayo_SP_Listings_step_3" />
      <bpmn:endEvent id="Ayo_SP_Listings_end" name="Responsibility outcome recorded" />
      <bpmn:sequenceFlow id="Ayo_SP_Listings_inner_end" sourceRef="Ayo_SP_Listings_step_3" targetRef="Ayo_SP_Listings_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Ayo_SP_Inventory" name="Manage Inventory and Seasonal Availability">
      <bpmn:documentation>Accept producer quantity/season updates and internal listing/order stock changes. The operational process also has a daily season-check trigger. Zero stock and out-of-season products are unavailable; replenishment restores availability only within the season and when listing eligibility remains valid.</bpmn:documentation>
      <bpmn:ioSpecification id="Ayo_SP_Inventory_io">
        <bpmn:dataInput id="Ayo_SP_Inventory_in_2" name="Paid-order stock changes" />
        <bpmn:dataInput id="Ayo_SP_Inventory_in_3" name="Confirmed product suspension decision" />
        <bpmn:dataOutput id="Ayo_SP_Inventory_out_1" name="Catalogue and availability" />
        <bpmn:inputSet id="Ayo_SP_Inventory_inputs">
          <bpmn:dataInputRefs>Ayo_SP_Inventory_in_2</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Ayo_SP_Inventory_in_3</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Ayo_SP_Inventory_outputs">
          <bpmn:dataOutputRefs>Ayo_SP_Inventory_out_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Ayo_DataIn_PaidStock">
        <bpmn:sourceRef>Ayo_Data_PaidStock</bpmn:sourceRef>
        <bpmn:targetRef>Ayo_SP_Inventory_in_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Ayo_DataIn_Suspension">
        <bpmn:sourceRef>Ayo_Data_Suspension</bpmn:sourceRef>
        <bpmn:targetRef>Ayo_SP_Inventory_in_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Ayo_DataOut_Inventory">
        <bpmn:sourceRef>Ayo_SP_Inventory_out_1</bpmn:sourceRef>
        <bpmn:targetRef>Ayo_Data_Catalogue</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="Ayo_SP_Inventory_start" name="Responsibility begins" />
      <bpmn:task id="Ayo_SP_Inventory_step_1" name="Apply quantity and seasonal changes" />
      <bpmn:sequenceFlow id="Ayo_SP_Inventory_inner_1" sourceRef="Ayo_SP_Inventory_start" targetRef="Ayo_SP_Inventory_step_1" />
      <bpmn:task id="Ayo_SP_Inventory_step_2" name="Evaluate stock, season and listing eligibility" />
      <bpmn:sequenceFlow id="Ayo_SP_Inventory_inner_2" sourceRef="Ayo_SP_Inventory_step_1" targetRef="Ayo_SP_Inventory_step_2" />
      <bpmn:task id="Ayo_SP_Inventory_step_3" name="Set and communicate current availability" />
      <bpmn:sequenceFlow id="Ayo_SP_Inventory_inner_3" sourceRef="Ayo_SP_Inventory_step_2" targetRef="Ayo_SP_Inventory_step_3" />
      <bpmn:endEvent id="Ayo_SP_Inventory_end" name="Responsibility outcome recorded" />
      <bpmn:sequenceFlow id="Ayo_SP_Inventory_inner_end" sourceRef="Ayo_SP_Inventory_step_3" targetRef="Ayo_SP_Inventory_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Ayo_SP_Purchasing" name="Facilitate Customer Purchasing">
      <bpmn:documentation>Support the three buyer segments browsing and selecting products. Check availability and explain producer responsibilities and delivery/collection arrangements before confirming the purchase request.</bpmn:documentation>
      <bpmn:ioSpecification id="Ayo_SP_Purchasing_io">
        <bpmn:dataInput id="Ayo_SP_Purchasing_in_1" name="Catalogue and availability" />
        <bpmn:inputSet id="Ayo_SP_Purchasing_inputs">
          <bpmn:dataInputRefs>Ayo_SP_Purchasing_in_1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Ayo_SP_Purchasing_outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Ayo_DataIn_Catalogue">
        <bpmn:sourceRef>Ayo_Data_Catalogue</bpmn:sourceRef>
        <bpmn:targetRef>Ayo_SP_Purchasing_in_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:startEvent id="Ayo_SP_Purchasing_start" name="Responsibility begins" />
      <bpmn:task id="Ayo_SP_Purchasing_step_1" name="Browse products and select basket" />
      <bpmn:sequenceFlow id="Ayo_SP_Purchasing_inner_1" sourceRef="Ayo_SP_Purchasing_start" targetRef="Ayo_SP_Purchasing_step_1" />
      <bpmn:task id="Ayo_SP_Purchasing_step_2" name="Check availability and delivery or collection arrangements" />
      <bpmn:sequenceFlow id="Ayo_SP_Purchasing_inner_2" sourceRef="Ayo_SP_Purchasing_step_1" targetRef="Ayo_SP_Purchasing_step_2" />
      <bpmn:task id="Ayo_SP_Purchasing_step_3" name="Record purchase request for coordination" />
      <bpmn:sequenceFlow id="Ayo_SP_Purchasing_inner_3" sourceRef="Ayo_SP_Purchasing_step_2" targetRef="Ayo_SP_Purchasing_step_3" />
      <bpmn:endEvent id="Ayo_SP_Purchasing_end" name="Responsibility outcome recorded" />
      <bpmn:sequenceFlow id="Ayo_SP_Purchasing_inner_end" sourceRef="Ayo_SP_Purchasing_step_3" targetRef="Ayo_SP_Purchasing_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Ayo_SP_Orders" name="Coordinate Multi-Vendor Orders">
      <bpmn:documentation>Create marketplace order records and producer-specific elements. Allocate responsibilities by producer. Actual producer confirmation follows successful payment; proposed fulfilment respects the case study 48-hour preparation lead time.</bpmn:documentation>
      <bpmn:startEvent id="Ayo_SP_Orders_start" name="Responsibility begins" />
      <bpmn:task id="Ayo_SP_Orders_step_1" name="Identify producers for each line item" />
      <bpmn:sequenceFlow id="Ayo_SP_Orders_inner_1" sourceRef="Ayo_SP_Orders_start" targetRef="Ayo_SP_Orders_step_1" />
      <bpmn:task id="Ayo_SP_Orders_step_2" name="Create marketplace and producer order records" />
      <bpmn:sequenceFlow id="Ayo_SP_Orders_inner_2" sourceRef="Ayo_SP_Orders_step_1" targetRef="Ayo_SP_Orders_step_2" />
      <bpmn:task id="Ayo_SP_Orders_step_3" name="Provide allocations and fulfilment responsibilities" />
      <bpmn:sequenceFlow id="Ayo_SP_Orders_inner_3" sourceRef="Ayo_SP_Orders_step_2" targetRef="Ayo_SP_Orders_step_3" />
      <bpmn:endEvent id="Ayo_SP_Orders_end" name="Responsibility outcome recorded" />
      <bpmn:sequenceFlow id="Ayo_SP_Orders_inner_end" sourceRef="Ayo_SP_Orders_step_3" targetRef="Ayo_SP_Orders_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Ayo_SP_Payments" name="Manage Payments and Producer Settlements">
      <bpmn:documentation>Request sandbox payment and handle success, decline or unavailable outcomes. Only successful paid orders generate confirmed producer orders and stock-change records. Calculate the 5% marketplace commission and producer allocations. Weekly settlement is a separate business cadence, not a new transfer for every purchase.</bpmn:documentation>
      <bpmn:ioSpecification id="Ayo_SP_Payments_io">
        <bpmn:dataOutput id="Ayo_SP_Payments_out_1" name="Paid-order stock changes" />
        <bpmn:inputSet id="Ayo_SP_Payments_inputs" />
        <bpmn:outputSet id="Ayo_SP_Payments_outputs">
          <bpmn:dataOutputRefs>Ayo_SP_Payments_out_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Ayo_DataOut_PaidStock">
        <bpmn:sourceRef>Ayo_SP_Payments_out_1</bpmn:sourceRef>
        <bpmn:targetRef>Ayo_Data_PaidStock</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="Ayo_SP_Payments_start" name="Responsibility begins" />
      <bpmn:task id="Ayo_SP_Payments_step_1" name="Request sandbox payment and handle outcome" />
      <bpmn:sequenceFlow id="Ayo_SP_Payments_inner_1" sourceRef="Ayo_SP_Payments_start" targetRef="Ayo_SP_Payments_step_1" />
      <bpmn:task id="Ayo_SP_Payments_step_2" name="Record paid allocations and confirmed producer orders" />
      <bpmn:sequenceFlow id="Ayo_SP_Payments_inner_2" sourceRef="Ayo_SP_Payments_step_1" targetRef="Ayo_SP_Payments_step_2" />
      <bpmn:task id="Ayo_SP_Payments_step_3" name="Prepare weekly settlements and statements when due" />
      <bpmn:sequenceFlow id="Ayo_SP_Payments_inner_3" sourceRef="Ayo_SP_Payments_step_2" targetRef="Ayo_SP_Payments_step_3" />
      <bpmn:endEvent id="Ayo_SP_Payments_end" name="Responsibility outcome recorded" />
      <bpmn:sequenceFlow id="Ayo_SP_Payments_inner_end" sourceRef="Ayo_SP_Payments_step_3" targetRef="Ayo_SP_Payments_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Ayo_SP_Quality" name="Food Quality and Traceability">
      <bpmn:documentation>A producer, customer or internal administrator may report a concern. Trace affected products, producers and customer orders; request producer evidence. Confirmed risks may cause suspension and customer notification. Record notification results and failed-contact follow-up; authorised admin reviews closure or requests further action.</bpmn:documentation>
      <bpmn:ioSpecification id="Ayo_SP_Quality_io">
        <bpmn:dataOutput id="Ayo_SP_Quality_out_1" name="Confirmed product suspension decision" />
        <bpmn:inputSet id="Ayo_SP_Quality_inputs" />
        <bpmn:outputSet id="Ayo_SP_Quality_outputs">
          <bpmn:dataOutputRefs>Ayo_SP_Quality_out_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Ayo_DataOut_Suspension">
        <bpmn:sourceRef>Ayo_SP_Quality_out_1</bpmn:sourceRef>
        <bpmn:targetRef>Ayo_Data_Suspension</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="Ayo_SP_Quality_start" name="Responsibility begins" />
      <bpmn:task id="Ayo_SP_Quality_step_1" name="Record concern and trace affected orders" />
      <bpmn:sequenceFlow id="Ayo_SP_Quality_inner_1" sourceRef="Ayo_SP_Quality_start" targetRef="Ayo_SP_Quality_step_1" />
      <bpmn:task id="Ayo_SP_Quality_step_2" name="Investigate and decide risk and necessary actions" />
      <bpmn:sequenceFlow id="Ayo_SP_Quality_inner_2" sourceRef="Ayo_SP_Quality_step_1" targetRef="Ayo_SP_Quality_step_2" />
      <bpmn:task id="Ayo_SP_Quality_step_3" name="Record suspension, notifications, follow-up and authorised closure" />
      <bpmn:sequenceFlow id="Ayo_SP_Quality_inner_3" sourceRef="Ayo_SP_Quality_step_2" targetRef="Ayo_SP_Quality_step_3" />
      <bpmn:endEvent id="Ayo_SP_Quality_end" name="Responsibility outcome recorded" />
      <bpmn:sequenceFlow id="Ayo_SP_Quality_inner_end" sourceRef="Ayo_SP_Quality_step_3" targetRef="Ayo_SP_Quality_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Ayo_SP_Community" name="Support Sustainability and Community Engagement">
      <bpmn:documentation>Coordinate producer surplus discounts, recipes, storage guidance, farm stories and local food education. Postcode-based food-mile information supports sustainability. Community initiatives can also be initiated internally; this strategic example shows producer content as one entry point.</bpmn:documentation>
      <bpmn:startEvent id="Ayo_SP_Community_start" name="Responsibility begins" />
      <bpmn:task id="Ayo_SP_Community_step_1" name="Receive surplus or educational content" />
      <bpmn:sequenceFlow id="Ayo_SP_Community_inner_1" sourceRef="Ayo_SP_Community_start" targetRef="Ayo_SP_Community_step_1" />
      <bpmn:task id="Ayo_SP_Community_step_2" name="Coordinate sustainability and community activity" />
      <bpmn:sequenceFlow id="Ayo_SP_Community_inner_2" sourceRef="Ayo_SP_Community_step_1" targetRef="Ayo_SP_Community_step_2" />
      <bpmn:task id="Ayo_SP_Community_step_3" name="Publish updates and record activity outcomes" />
      <bpmn:sequenceFlow id="Ayo_SP_Community_inner_3" sourceRef="Ayo_SP_Community_step_2" targetRef="Ayo_SP_Community_step_3" />
      <bpmn:endEvent id="Ayo_SP_Community_end" name="Responsibility outcome recorded" />
      <bpmn:sequenceFlow id="Ayo_SP_Community_inner_end" sourceRef="Ayo_SP_Community_step_3" targetRef="Ayo_SP_Community_end" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Ayo_End_Listing" name="Listing decision recorded" />
    <bpmn:endEvent id="Ayo_End_Inventory" name="Availability updated" />
    <bpmn:endEvent id="Ayo_End_Quality" name="Incident action or closure recorded" />
    <bpmn:endEvent id="Ayo_End_Community" name="Community activity recorded" />
    <bpmn:endEvent id="Ayo_End_Order" name="Order confirmed" />
    <bpmn:endEvent id="Ayo_End_NotPaid" name="Payment not confirmed" />
    <bpmn:exclusiveGateway id="Ayo_Gateway_Payment" name="Payment accepted?" default="Ayo_Seq_PaymentNo" />
    <bpmn:sequenceFlow id="Ayo_Seq_L1" sourceRef="Ayo_Start_Listing" targetRef="Ayo_SP_Listings" />
    <bpmn:sequenceFlow id="Ayo_Seq_L2" sourceRef="Ayo_SP_Listings" targetRef="Ayo_End_Listing" />
    <bpmn:sequenceFlow id="Ayo_Seq_I1" sourceRef="Ayo_Start_Inventory" targetRef="Ayo_SP_Inventory" />
    <bpmn:sequenceFlow id="Ayo_Seq_I2" sourceRef="Ayo_SP_Inventory" targetRef="Ayo_End_Inventory" />
    <bpmn:sequenceFlow id="Ayo_Seq_O1" sourceRef="Ayo_Start_Purchase" targetRef="Ayo_SP_Purchasing" />
    <bpmn:sequenceFlow id="Ayo_Seq_O2" sourceRef="Ayo_SP_Purchasing" targetRef="Ayo_SP_Orders" />
    <bpmn:sequenceFlow id="Ayo_Seq_O3" sourceRef="Ayo_SP_Orders" targetRef="Ayo_SP_Payments" />
    <bpmn:sequenceFlow id="Ayo_Seq_O4" sourceRef="Ayo_SP_Payments" targetRef="Ayo_Gateway_Payment" />
    <bpmn:sequenceFlow id="Ayo_Seq_Q1" sourceRef="Ayo_Start_Quality" targetRef="Ayo_SP_Quality" />
    <bpmn:sequenceFlow id="Ayo_Seq_Q2" sourceRef="Ayo_SP_Quality" targetRef="Ayo_End_Quality" />
    <bpmn:sequenceFlow id="Ayo_Seq_C1" sourceRef="Ayo_Start_Community" targetRef="Ayo_SP_Community" />
    <bpmn:sequenceFlow id="Ayo_Seq_C2" sourceRef="Ayo_SP_Community" targetRef="Ayo_End_Community" />
    <bpmn:sequenceFlow id="Ayo_Seq_PaymentYes" sourceRef="Ayo_Gateway_Payment" targetRef="Ayo_End_Order" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentConfirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Ayo_Seq_PaymentNo" sourceRef="Ayo_Gateway_Payment" targetRef="Ayo_End_NotPaid" name="No / unresolved" />
    <bpmn:dataStoreReference id="Ayo_Data_Catalogue" name="Catalogue and availability" dataStoreRef="Ayo_Store_Catalogue" />
    <bpmn:dataObject id="Ayo_Data_PaidStock_object" />
    <bpmn:dataObjectReference id="Ayo_Data_PaidStock" name="Paid-order stock changes" dataObjectRef="Ayo_Data_PaidStock_object" />
    <bpmn:dataObject id="Ayo_Data_Suspension_object" />
    <bpmn:dataObjectReference id="Ayo_Data_Suspension" name="Confirmed product suspension decision" dataObjectRef="Ayo_Data_Suspension_object" />
    <bpmn:textAnnotation id="Ayo_Note_AdminListings">
      <bpmn:text>Internal role: Marketplace Admin. Review unresolved verification only under an agreed policy.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Ayo_Note_AdminListings_association" sourceRef="Ayo_SP_Listings" targetRef="Ayo_Note_AdminListings" associationDirection="None" />
    <bpmn:textAnnotation id="Ayo_Note_InventoryTriggers">
      <bpmn:text>Also triggered internally by listing/order stock changes and daily season checks. Zero stock or out of season means unavailable.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Ayo_Note_InventoryTriggers_association" sourceRef="Ayo_SP_Inventory" targetRef="Ayo_Note_InventoryTriggers" associationDirection="None" />
    <bpmn:textAnnotation id="Ayo_Note_Settlements">
      <bpmn:text>5% commission and producer shares; weekly settlement cadence. Confirm producer orders only after successful payment.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Ayo_Note_Settlements_association" sourceRef="Ayo_SP_Payments" targetRef="Ayo_Note_Settlements" associationDirection="None" />
    <bpmn:textAnnotation id="Ayo_Note_AdminQuality">
      <bpmn:text>Internal role: Marketplace Admin. May report concerns and authorises action/closure; failed customer contacts require follow-up.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Ayo_Note_AdminQuality_association" sourceRef="Ayo_SP_Quality" targetRef="Ayo_Note_AdminQuality" associationDirection="None" />
    <bpmn:textAnnotation id="Ayo_Note_Community">
      <bpmn:text>Surplus discounts, recipes, storage guidance, farm stories, food education and postcode-based food-mile information.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Ayo_Note_Community_association" sourceRef="Ayo_SP_Community" targetRef="Ayo_Note_Community" associationDirection="None" />
  </bpmn:process>
